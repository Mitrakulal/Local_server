<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.inunity.gemma-chat-router</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIRECTORY__/gateway/scripts/start-chat-router.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIRECTORY__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIRECTORY__/gateway/logs/chat-router.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIRECTORY__/gateway/logs/chat-router.err.log</string>
</dict>
</plist>
