# Phase 1 local-only gateway configuration. Copy to gateway/.env and chmod 600 gateway/.env.
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8787
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_BACKEND_MODEL=ggml-org/gemma-4-E2B-it-GGUF:Q8_0
GATEWAY_PUBLIC_MODEL=gemma-e2b

# Generate each value with: openssl rand -hex 32
GATEWAY_KEY_PEPPER=REPLACE_WITH_A_64_HEX_CHARACTER_SECRET
GATEWAY_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
# Used only by the private port-3000 Owner Console; never share it with customers.
OWNER_CONSOLE_TOKEN=REPLACE_WITH_A_THIRD_64_HEX_CHARACTER_SECRET

# Leave blank while llama.cpp remains local-only without an internal key.
LLAMA_API_KEY=

GATEWAY_DATA_DIR=./gateway/data
GATEWAY_GLOBAL_CONCURRENT=4
GATEWAY_PER_KEY_CONCURRENT=1
GATEWAY_DEFAULT_MAX_OUTPUT=512
GATEWAY_ABSOLUTE_MAX_OUTPUT=8192
GATEWAY_MAX_BODY_BYTES=262144
GATEWAY_MAX_MESSAGES=64
GATEWAY_MAX_INPUT_CHARACTERS=24000
GATEWAY_REQUEST_TIMEOUT_MS=120000
GATEWAY_RATE_BURST=2
GATEWAY_DEFAULT_RPM=6
GATEWAY_DEFAULT_DAILY_REQUESTS=50
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
